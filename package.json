{
	"name": "behringer-wing",
	"version": "3.0.0-alpha.3",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"docs": "node scripts/update-actions-md.js",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-behringer-wing.git"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"debounce-fn": "^6.0.0",
		"osc": "^2.4.5",
		"p-queue": "^8.0.1",
		"type-fest": "^4.31.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"resolutions": {
		"ws": "^8.21.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
